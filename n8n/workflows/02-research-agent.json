{
  "name": "02 — Research Agent (Webhook)",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "research-topic", "options": { "responseMode": "responseNode" } },
      "id": "webhook-in",
      "name": "Webhook: Research Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "webhookId": "research-topic"
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "leftValue": "={{ $json.body.topic }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }]
        }
      },
      "id": "validate-topic",
      "name": "Validate: Topic Present",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [320, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/research",
        "sendBody": true,
        "bodyParameters": { "parameters": [{ "name": "topic", "value": "={{ $json.body.topic }}" }] }
      },
      "id": "trigger-research",
      "name": "Queue Research Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [540, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"topic is required\", \"status\": 400 }"
      },
      "id": "respond-error",
      "name": "Respond: Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [540, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ jobId: $json.jobId, status: 'queued', topic: $('Webhook: Research Request').item.json.body.topic }) }}"
      },
      "id": "respond-ok",
      "name": "Respond: OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [760, 200]
    }
  ],
  "connections": {
    "Webhook: Research Request": { "main": [[{ "node": "Validate: Topic Present", "type": "main", "index": 0 }]] },
    "Validate: Topic Present": {
      "main": [
        [{ "node": "Queue Research Job", "type": "main", "index": 0 }],
        [{ "node": "Respond: Error", "type": "main", "index": 0 }]
      ]
    },
    "Queue Research Job": { "main": [[{ "node": "Respond: OK", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "AI Content Factory" }]
}
