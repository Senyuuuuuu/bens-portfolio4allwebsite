{
  "name": "01 — Google Maps Business Discovery",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] } },
      "id": "cron-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/maps/search",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "category", "value": "Resort" },
            { "name": "location", "value": "Miami, FL" },
            { "name": "limit", "value": 15 }
          ]
        }
      },
      "id": "search-maps",
      "name": "1. Google Maps Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [320, 300]
    },
    { "parameters": { "amount": 10, "unit": "seconds" }, "id": "wait-job", "name": "Wait for Discovery", "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [540, 300] },
    {
      "parameters": {
        "url": "=http://host.docker.internal:4000/api/jobs/{{ $('1. Google Maps Search').item.json.jobId }}",
        "options": {}
      },
      "id": "get-job-result",
      "name": "2. Get Discovered Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [760, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/webhooks/events",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "event", "value": "LEADS_DISCOVERED" },
            { "name": "data", "value": "={ \"count\": {{ $json.output.count }}, \"timestamp\": \"{{ new Date().toISOString() }}\" }" }
          ]
        }
      },
      "id": "notify-dashboard",
      "name": "3. Broadcast to Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [980, 300]
    }
  ],
  "connections": {
    "Every 6 Hours": { "main": [[{ "node": "1. Google Maps Search", "type": "main", "index": 0 }]] },
    "1. Google Maps Search": { "main": [[{ "node": "Wait for Discovery", "type": "main", "index": 0 }]] },
    "Wait for Discovery": { "main": [[{ "node": "2. Get Discovered Leads", "type": "main", "index": 0 }]] },
    "2. Get Discovered Leads": { "main": [[{ "node": "3. Broadcast to Dashboard", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "AI Lead Gen & Website Platform" }]
}
