{
  "name": "10 — Batch Job Processor (Loop Pattern)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 */6 * * *" }] } },
      "id": "cron-batch",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/trending?limit=50",
        "options": {}
      },
      "id": "get-trends",
      "name": "Fetch Top Trends",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "trends",
        "options": {}
      },
      "id": "split-trends",
      "name": "Split Trends",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [540, 300]
    },
    {
      "parameters": {
        "batchSize": 5,
        "options": {}
      },
      "id": "batch-5",
      "name": "Process 5 at a Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [760, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/research",
        "sendBody": true,
        "bodyParameters": { "parameters": [{ "name": "topic", "value": "={{ $json.title }}" }] }
      },
      "id": "research-trend",
      "name": "Queue Research for Each Trend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [980, 300]
    },
    { "parameters": { "amount": 2, "unit": "seconds" }, "id": "rate-limit", "name": "Rate Limit Delay", "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [1200, 300] }
  ],
  "connections": {
    "Every 6 Hours": { "main": [[{ "node": "Fetch Top Trends", "type": "main", "index": 0 }]] },
    "Fetch Top Trends": { "main": [[{ "node": "Split Trends", "type": "main", "index": 0 }]] },
    "Split Trends": { "main": [[{ "node": "Process 5 at a Time", "type": "main", "index": 0 }]] },
    "Process 5 at a Time": { "main": [[{ "node": "Queue Research for Each Trend", "type": "main", "index": 0 }]] },
    "Queue Research for Each Trend": { "main": [[{ "node": "Rate Limit Delay", "type": "main", "index": 0 }]] },
    "Rate Limit Delay": { "main": [[{ "node": "Process 5 at a Time", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "AI Content Factory" }]
}
