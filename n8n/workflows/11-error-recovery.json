{
  "name": "11 — Error Recovery + Dead Letter Queue",
  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "jsCode": "const err = $input.first().json;\nconst workflow = err.workflow || {};\nconst execution = err.execution || {};\n\nreturn [{ json: {\n  workflowId: workflow.id,\n  workflowName: workflow.name,\n  executionId: execution.id,\n  errorMessage: err.error?.message || 'Unknown error',\n  errorStack: err.error?.stack || '',\n  failedAt: new Date().toISOString(),\n  severity: (err.error?.message || '').includes('timeout') ? 'warning' : 'error'\n} }];"
      },
      "id": "extract-error",
      "name": "Extract Error Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/webhooks/events",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "event", "value": "WORKFLOW_ERROR" },
            { "name": "data", "value": "={{ JSON.stringify($json) }}" }
          ]
        }
      },
      "id": "log-to-backend",
      "name": "Log Error to Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [540, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "leftValue": "={{ $json.severity }}", "rightValue": "error", "operator": { "type": "string", "operation": "equals" } }]
        }
      },
      "id": "is-critical",
      "name": "Critical Error?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "errorMessage": "=Critical workflow failure: {{ $json.workflowName }} — {{ $json.errorMessage }}"
      },
      "id": "stop-error",
      "name": "Stop: Mark as Failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [980, 200]
    },
    {
      "parameters": { "mode": "passThrough" },
      "id": "soft-fail",
      "name": "Soft Fail (Warning Only)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [980, 400]
    }
  ],
  "connections": {
    "On Workflow Error": { "main": [[{ "node": "Extract Error Details", "type": "main", "index": 0 }]] },
    "Extract Error Details": { "main": [[{ "node": "Log Error to Backend", "type": "main", "index": 0 }]] },
    "Log Error to Backend": { "main": [[{ "node": "Critical Error?", "type": "main", "index": 0 }]] },
    "Critical Error?": {
      "main": [
        [{ "node": "Stop: Mark as Failed", "type": "main", "index": 0 }],
        [{ "node": "Soft Fail (Warning Only)", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1", "errorWorkflow": "" },
  "tags": [{ "name": "AI Content Factory" }]
}
