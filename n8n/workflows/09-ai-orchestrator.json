{
  "name": "09 — AI Agent Orchestrator (n8n AI Pattern)",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "ai-orchestrate", "options": { "responseMode": "responseNode" } },
      "id": "webhook-chat",
      "name": "Webhook: Orchestrate Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "webhookId": "ai-orchestrate"
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "options": { "temperature": 0.3 }
      },
      "id": "openai-model",
      "name": "OpenAI GPT-4o",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.1,
      "position": [540, 500]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/system",
        "description": "Get current system status including agent states, queue stats, and resource usage",
        "method": "GET"
      },
      "id": "system-tool",
      "name": "Tool: Get System Status",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [760, 500]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/trending?limit=10",
        "description": "Get current trending topics discovered by the Trend Hunter agent",
        "method": "GET"
      },
      "id": "trends-tool",
      "name": "Tool: Get Trends",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [960, 500]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/jobs?limit=20",
        "description": "Get recent job queue status to understand what the factory is currently processing",
        "method": "GET"
      },
      "id": "jobs-tool",
      "name": "Tool: Get Jobs",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [1160, 500]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.body.sessionId || 'default' }}",
        "contextWindowLength": 10
      },
      "id": "memory",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.2,
      "position": [1360, 500]
    },
    {
      "parameters": {
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "You are the AI Content Factory orchestrator. You have access to tools to check system status, view trends, and monitor jobs. Help the user understand what's happening in their content factory, make recommendations, and guide them through using the system. Be concise and action-oriented. When you see issues, suggest specific fixes. Format responses with emoji for readability."
        }
      },
      "id": "ai-agent",
      "name": "AI Factory Orchestrator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [320, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ response: $json.output, sessionId: $('Webhook: Orchestrate Request').item.json.body.sessionId }) }}"
      },
      "id": "respond",
      "name": "Respond with AI Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [540, 300]
    }
  ],
  "connections": {
    "Webhook: Orchestrate Request": { "main": [[{ "node": "AI Factory Orchestrator", "type": "main", "index": 0 }]] },
    "OpenAI GPT-4o": { "ai_languageModel": [[{ "node": "AI Factory Orchestrator", "type": "ai_languageModel", "index": 0 }]] },
    "Tool: Get System Status": { "ai_tool": [[{ "node": "AI Factory Orchestrator", "type": "ai_tool", "index": 0 }]] },
    "Tool: Get Trends": { "ai_tool": [[{ "node": "AI Factory Orchestrator", "type": "ai_tool", "index": 1 }]] },
    "Tool: Get Jobs": { "ai_tool": [[{ "node": "AI Factory Orchestrator", "type": "ai_tool", "index": 2 }]] },
    "Window Buffer Memory": { "ai_memory": [[{ "node": "AI Factory Orchestrator", "type": "ai_memory", "index": 0 }]] },
    "AI Factory Orchestrator": { "main": [[{ "node": "Respond with AI Reply", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "AI Content Factory" }]
}
