{
  "name": "Human-in-the-Loop (HITL) Social Media Content Engine",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [1],
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "b1c2d3e4-0001-4000-8000-000000000001",
      "name": "Schedule Trigger (Mondays 9AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "url": "https://api.spaceflightnewsapi.net/v4/articles/?limit=5",
        "options": {}
      },
      "id": "b1c2d3e4-0001-4000-8000-000000000002",
      "name": "Fetch Industry News & Trends",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "prompt": "=Analyze the following trending industry news item:\nTitle: {{ $json.results[0].title }}\nSummary: {{ $json.results[0].summary }}\nURL: {{ $json.results[0].url }}\n\nTask: Draft a viral, high-authority LinkedIn post with a strong hook, 3 key analytical takeaways, engaging questions to drive comments, and relevant hashtags (#AI #Automation #FutureOfTech).",
        "options": {
          "temperature": 0.7,
          "maxTokens": 800
        }
      },
      "id": "b1c2d3e4-0001-4000-8000-000000000003",
      "name": "AI Draft LinkedIn Post",
      "type": "@n8n/n8n-nodes-base.openAi",
      "typeVersion": 1.4,
      "position": [700, 300],
      "credentials": {
        "openAiApi": {
          "id": "mock-openai-credential",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "channel": "#content-approvals",
        "text": "=🤖 *New AI Draft Ready for Review:*\n\n```\n{{ $json.message.content }}\n```\n\n*Source:* {{ $('Fetch Industry News & Trends').item.json.results[0].title }}\n\n👇 Please select an action below:",
        "otherOptions": {
          "attachments": [
            {
              "callback_id": "hitl_post_review",
              "text": "Review Post Action",
              "actions": [
                {
                  "name": "action",
                  "text": "✅ Approve & Schedule",
                  "type": "button",
                  "value": "approve",
                  "style": "primary"
                },
                {
                  "name": "action",
                  "text": "🔄 Regenerate Draft",
                  "type": "button",
                  "value": "regenerate",
                  "style": "danger"
                }
              ]
            }
          ]
        }
      },
      "id": "b1c2d3e4-0001-4000-8000-000000000004",
      "name": "Send Slack Interactive Buttons",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [940, 300],
      "credentials": {
        "slackApi": {
          "id": "mock-slack-credential",
          "name": "Slack API account"
        }
      }
    },
    {
      "parameters": {
        "resume": "webhook",
        "webhookSuffix": "hitl-approval-callback"
      },
      "id": "b1c2d3e4-0001-4000-8000-000000000005",
      "name": "Wait for Human Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1160, 300],
      "webhookId": "hitl-approval-callback"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.actions[0].value || $json.body.action }}",
        "rules": {
          "rules": [
            {
              "value2": "approve",
              "outputKey": "Approved"
            },
            {
              "value2": "regenerate",
              "outputKey": "Regenerate"
            }
          ]
        },
        "fallbackOutput": 1
      },
      "id": "b1c2d3e4-0001-4000-8000-000000000006",
      "name": "Route by Human Decision",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1400, 300]
    },
    {
      "parameters": {
        "url": "https://api.linkedin.com/v2/ugcPosts",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.LINKEDIN_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"author\": \"urn:li:person:{{ $env.LINKEDIN_PERSON_ID }}\",\n  \"lifecycleState\": \"PUBLISHED\",\n  \"specificContent\": {\n    \"com.linkedin.ugc.ShareContent\": {\n      \"shareCommentary\": {\n        \"text\": \"{{ $('AI Draft LinkedIn Post').item.json.message.content }}\"\n      },\n      \"shareMediaCategory\": \"NONE\"\n    }\n  },\n  \"visibility\": {\n    \"com.linkedin.ugc.MemberNetworkVisibility\": \"PUBLIC\"\n  }\n}"
      },
      "id": "b1c2d3e4-0001-4000-8000-000000000007",
      "name": "Publish to LinkedIn API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 200]
    },
    {
      "parameters": {
        "channel": "#content-approvals",
        "text": "=⚠️ *Human Editor Requested Regeneration.* Re-prompting AI Agent with refined creative temperature."
      },
      "id": "b1c2d3e4-0001-4000-8000-000000000008",
      "name": "Notify Slack on Regenerate",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1680, 420]
    }
  ],
  "connections": {
    "Schedule Trigger (Mondays 9AM)": {
      "main": [
        [
          {
            "node": "Fetch Industry News & Trends",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Industry News & Trends": {
      "main": [
        [
          {
            "node": "AI Draft LinkedIn Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Draft LinkedIn Post": {
      "main": [
        [
          {
            "node": "Send Slack Interactive Buttons",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Slack Interactive Buttons": {
      "main": [
        [
          {
            "node": "Wait for Human Approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Human Approval": {
      "main": [
        [
          {
            "node": "Route by Human Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Human Decision": {
      "main": [
        [
          {
            "node": "Publish to LinkedIn API",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify Slack on Regenerate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "HITL"
    },
    {
      "name": "Social Media"
    },
    {
      "name": "Slack"
    }
  ]
}
