{
  "name": "06 — Google Drive Upload + Publish",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "upload-publish", "options": {} },
      "id": "webhook-upload",
      "name": "Webhook: Ready to Publish",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "webhookId": "upload-publish"
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/upload",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "filePath", "value": "={{ $json.body.filePath }}" },
            { "name": "fileName", "value": "={{ $json.body.fileName }}" },
            { "name": "drivePath", "value": "={{ $json.body.drivePath || 'AI Content Factory/Processed' }}" }
          ]
        }
      },
      "id": "upload-drive",
      "name": "1. Upload to Google Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "leftValue": "={{ $json.success }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }]
        }
      },
      "id": "upload-success",
      "name": "Upload Successful?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [540, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/publish",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "clipId", "value": "={{ $('Webhook: Ready to Publish').item.json.body.clipId }}" },
            { "name": "platform", "value": "={{ $('Webhook: Ready to Publish').item.json.body.platform || 'google_drive' }}" },
            { "name": "metadata", "value": "={{ JSON.stringify({ driveId: $json.driveId, driveUrl: $json.url }) }}" }
          ]
        }
      },
      "id": "publish",
      "name": "2. Publish Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [760, 200]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/webhooks/events",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "event", "value": "UPLOAD_FAILED" },
            { "name": "data", "value": "={ \"message\": \"Drive upload failed\", \"path\": \"{{ $('Webhook: Ready to Publish').item.json.body.filePath }}\" }" }
          ]
        }
      },
      "id": "log-error",
      "name": "Log Upload Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [760, 400]
    }
  ],
  "connections": {
    "Webhook: Ready to Publish": { "main": [[{ "node": "1. Upload to Google Drive", "type": "main", "index": 0 }]] },
    "1. Upload to Google Drive": { "main": [[{ "node": "Upload Successful?", "type": "main", "index": 0 }]] },
    "Upload Successful?": {
      "main": [
        [{ "node": "2. Publish Content", "type": "main", "index": 0 }],
        [{ "node": "Log Upload Error", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "AI Content Factory" }]
}
