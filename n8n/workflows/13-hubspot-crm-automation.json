{
  "name": "13 — HubSpot CRM Contact & Deal Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hubspot-sync",
        "options": {}
      },
      "id": "webhook-hubspot",
      "name": "Webhook: HubSpot Sync Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "webhookId": "hubspot-sync"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HUBSPOT_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [\n    {\n      \"filters\": [\n        {\n          \"propertyName\": \"email\",\n          \"operator\": \"EQ\",\n          \"value\": \"{{ $json.body.email }}\"\n        }\n      ]\n    }\n  ],\n  \"properties\": [\"email\", \"firstname\", \"lastname\", \"company\", \"hubspot_owner_id\"]\n}"
      },
      "id": "search-contact",
      "name": "1. Search Contact by Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.total }}",
              "operation": "equal",
              "value2": 0
            }
          ]
        }
      },
      "id": "check-contact-exists",
      "name": "2. Contact Exists Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [540, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HUBSPOT_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"email\": \"{{ $('Webhook: HubSpot Sync Request').item.json.body.email }}\",\n    \"firstname\": \"{{ $('Webhook: HubSpot Sync Request').item.json.body.firstname }}\",\n    \"lastname\": \"{{ $('Webhook: HubSpot Sync Request').item.json.body.lastname }}\",\n    \"phone\": \"{{ $('Webhook: HubSpot Sync Request').item.json.body.phone }}\",\n    \"company\": \"{{ $('Webhook: HubSpot Sync Request').item.json.body.company }}\"\n  }\n}"
      },
      "id": "create-contact",
      "name": "3a. Create New Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [780, 200]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/{{ $('1. Search Contact by Email').item.json.results[0].id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HUBSPOT_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"firstname\": \"{{ $('Webhook: HubSpot Sync Request').item.json.body.firstname }}\",\n    \"lastname\": \"{{ $('Webhook: HubSpot Sync Request').item.json.body.lastname }}\",\n    \"phone\": \"{{ $('Webhook: HubSpot Sync Request').item.json.body.phone }}\"\n  }\n}"
      },
      "id": "update-contact",
      "name": "3b. Update Existing Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [780, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/deals",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HUBSPOT_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"dealname\": \"{{ $('Webhook: HubSpot Sync Request').item.json.body.company }} - AI Automation Deal\",\n    \"pipeline\": \"default\",\n    \"dealstage\": \"appointmentscheduled\",\n    \"amount\": \"{{ $('Webhook: HubSpot Sync Request').item.json.body.dealAmount || 5000 }}\"\n  }\n}"
      },
      "id": "create-deal",
      "name": "4. Create Associated Deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1020, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:5000/api/webhooks/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event\": \"HUBSPOT_CRM_SYNCED\",\n  \"data\": {\n    \"email\": \"{{ $('Webhook: HubSpot Sync Request').item.json.body.email }}\",\n    \"contactId\": \"{{ $json.id }}\",\n    \"status\": \"SUCCESS\"\n  }\n}"
      },
      "id": "broadcast-hubspot-event",
      "name": "5. Broadcast Event to JARVIS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1260, 300]
    }
  ],
  "connections": {
    "Webhook: HubSpot Sync Request": {
      "main": [[{ "node": "1. Search Contact by Email", "type": "main", "index": 0 }]]
    },
    "1. Search Contact by Email": {
      "main": [[{ "node": "2. Contact Exists Check", "type": "main", "index": 0 }]]
    },
    "2. Contact Exists Check": {
      "main": [
        [{ "node": "3a. Create New Contact", "type": "main", "index": 0 }],
        [{ "node": "3b. Update Existing Contact", "type": "main", "index": 0 }]
      ]
    },
    "3a. Create New Contact": {
      "main": [[{ "node": "4. Create Associated Deal", "type": "main", "index": 0 }]]
    },
    "3b. Update Existing Contact": {
      "main": [[{ "node": "4. Create Associated Deal", "type": "main", "index": 0 }]]
    },
    "4. Create Associated Deal": {
      "main": [[{ "node": "5. Broadcast Event to JARVIS", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "JARVIS CRM Automation" }]
}
