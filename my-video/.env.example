# -----------------------------------------------------------------------------
# Remotion & Google Drive Automation Environment Configuration
# -----------------------------------------------------------------------------

# ID of the target Google Drive Folder (found in the folder's URL)
# Example URL: https://drive.google.com/drive/folders/1A2B3C4D5E6F7G8H9I0J
GOOGLE_DRIVE_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J

# Relative or absolute file path to your downloaded Google Service Account JSON Key
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Remotion Composition ID to render
REMOTION_COMPOSITION_ID=OHMnibusLogoAnimation
