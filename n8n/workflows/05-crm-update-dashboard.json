{
  "name": "05 — CRM Pipeline Update & Dashboard Sync",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "crm-sync", "options": {} },
      "id": "webhook-crm",
      "name": "Webhook: CRM Sync",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "webhookId": "crm-sync"
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/crm/update",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "leadId", "value": "={{ $json.body.leadId }}" },
            { "name": "stage", "value": "={{ $json.body.stage }}" },
            { "name": "notes", "value": "={{ $json.body.notes }}" }
          ]
        }
      },
      "id": "update-crm",
      "name": "1. Update Lead Stage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/webhooks/events",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "event", "value": "CRM_STAGE_UPDATED" },
            { "name": "data", "value": "={ \"leadId\": \"{{ $('Webhook: CRM Sync').item.json.body.leadId }}\", \"stage\": \"{{ $('Webhook: CRM Sync').item.json.body.stage }}\" }" }
          ]
        }
      },
      "id": "broadcast-crm",
      "name": "2. Broadcast Stage Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [540, 300]
    }
  ],
  "connections": {
    "Webhook: CRM Sync": { "main": [[{ "node": "1. Update Lead Stage", "type": "main", "index": 0 }]] },
    "1. Update Lead Stage": { "main": [[{ "node": "2. Broadcast Stage Update", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "AI Lead Gen & Website Platform" }]
}
