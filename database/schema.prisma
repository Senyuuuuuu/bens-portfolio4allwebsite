// Prisma schema file for AI Lead Gen & Website Automation Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  USER
}

// ─── Business Lead ───────────────────────────────────────────────
model BusinessLead {
  id               String           @id @default(cuid())
  name             String
  category         String
  rating           Float?
  reviewCount      Int              @default(0)
  phone            String?
  email            String?
  website          String?
  facebookUrl      String?
  instagramUrl     String?
  address          String?
  latitude         Float?
  longitude        Float?
  businessHours    Json?
  
  hasWebsite       Boolean          @default(false)
  leadScore        Int              @default(0) // 0 - 100 score
  priority         Priority         @default(MEDIUM)
  pipelineStage    PipelineStage    @default(QUALIFIED)
  estimatedRevenue String?
  notes            String?          @db.Text
  
  audit            WebsiteAudit?
  social           SocialProfile?
  intelligence     BusinessIntelligence?
  websiteDemos     GeneratedWebsite[]
  screenshots      Screenshot[]
  outreachDrafts   OutreachDraft[]
  jobs             Job[]
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("business_leads")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PipelineStage {
  QUALIFIED
  WEBSITE_AUDITED
  WEBSITE_GENERATED
  OUTREACH_DRAFTED
  OUTREACH_SENT
  INTERESTED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  WON
  LOST
}

// ─── Website Audit ───────────────────────────────────────────────
model WebsiteAudit {
  id               String       @id @default(cuid())
  leadId           String       @unique
  lead             BusinessLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  hasSsl           Boolean      @default(false)
  isMobileFriendly Boolean      @default(false)
  loadTimeMs       Int          @default(0)
  seoScore         Int          @default(0)
  qualityScore     Int          @default(0) // 0-100 overall score
  
  hasBooking       Boolean      @default(false)
  hasContactForm   Boolean      @default(false)
  missingFeatures  String[]     @default([])
  auditReport      Json?
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("website_audits")
}

// ─── Social Profile ──────────────────────────────────────────────
model SocialProfile {
  id             String       @id @default(cuid())
  leadId         String       @unique
  lead           BusinessLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  platform       String       @default("Facebook")
  pageUrl        String?
  followerCount  Int          @default(0)
  postCount      Int          @default(0)
  lastActiveDate DateTime?
  hasPhotoAssets Boolean      @default(false)
  bioSummary     String?      @db.Text
  profileData    Json?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("social_profiles")
}

// ─── Business Intelligence ───────────────────────────────────────
model BusinessIntelligence {
  id              String       @id @default(cuid())
  leadId          String       @unique
  lead            BusinessLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  summary         String       @db.Text
  services        String[]     @default([])
  brandStyle      String?      // e.g. "Modern, Sleek", "Warm, Rustic"
  colorPalette    String[]     @default([]) // Hex codes
  targetAudience  String?
  improvements    String[]     @default([])
  aiRecommendations Json?
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("business_intelligences")
}

// ─── Generated Website ───────────────────────────────────────────
model GeneratedWebsite {
  id             String       @id @default(cuid())
  leadId         String
  lead           BusinessLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  title          String
  slug           String       @unique
  templateName   String       @default("Modern Business")
  htmlCode       String       @db.Text
  cssCode        String       @db.Text
  jsCode         String       @db.Text
  reactCode      String       @db.Text
  
  previewUrl     String?
  exportZipPath  String?
  version        Int          @default(1)
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("generated_websites")
}

// ─── Screenshot ──────────────────────────────────────────────────
model Screenshot {
  id             String       @id @default(cuid())
  leadId         String
  lead           BusinessLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  viewport       ViewportType
  imagePath      String
  imageUrl       String?
  
  createdAt      DateTime     @default(now())

  @@map("screenshots")
}

enum ViewportType {
  DESKTOP
  TABLET
  MOBILE
  HERO
}

// ─── Outreach Draft ──────────────────────────────────────────────
model OutreachDraft {
  id             String         @id @default(cuid())
  leadId         String
  lead           BusinessLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  channel        OutreachChannel
  subject        String?
  bodyText       String         @db.Text
  status         DraftStatus    @default(DRAFT)
  approvedAt     DateTime?
  sentAt         DateTime?
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("outreach_drafts")
}

enum OutreachChannel {
  EMAIL
  FACEBOOK_MSG
  LINKEDIN_MSG
  SMS
}

enum DraftStatus {
  DRAFT
  APPROVED
  SENT
  REJECTED
}

// ─── Job ─────────────────────────────────────────────────────────
model Job {
  id             String       @id @default(cuid())
  type           String
  status         JobStatus    @default(PENDING)
  priority       Int          @default(5)
  progress       Int          @default(0)
  input          Json?
  output         Json?
  error          String?
  
  leadId         String?
  lead           BusinessLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agentId        String?
  
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("jobs")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ─── Log ─────────────────────────────────────────────────────────
model Log {
  id        String   @id @default(cuid())
  level     String   // debug, info, success, warning, error
  message   String
  agentId   String?
  jobId     String?
  meta      Json?
  timestamp DateTime @default(now())

  @@map("logs")
}

// ─── Setting ─────────────────────────────────────────────────────
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("settings")
}
