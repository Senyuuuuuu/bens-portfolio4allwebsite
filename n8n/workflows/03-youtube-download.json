{
  "name": "03 — Video Download Pipeline",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "video-download", "options": {} },
      "id": "webhook-trigger",
      "name": "Webhook: Download Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "video-download"
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/download",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "url", "value": "={{ $json.body.url }}" },
            { "name": "callbackUrl", "value": "http://host.docker.internal:5678/webhook/download-complete" }
          ]
        }
      },
      "id": "queue-download",
      "name": "Queue Download Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 300]
    },
    {
      "parameters": { "amount": 5, "unit": "seconds" },
      "id": "wait-1",
      "name": "Wait 5s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [660, 300]
    },
    {
      "parameters": {
        "url": "=http://host.docker.internal:4000/api/jobs/{{ $('Queue Download Job').item.json.jobId }}",
        "options": {}
      },
      "id": "poll-job",
      "name": "Poll Job Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [880, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4000/api/transcribe",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "videoId", "value": "={{ $json.output.videoId }}" },
            { "name": "videoPath", "value": "={{ $json.output.path }}" }
          ]
        }
      },
      "id": "trigger-transcribe",
      "name": "Queue Transcription",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1100, 300]
    }
  ],
  "connections": {
    "Webhook: Download Request": { "main": [[{ "node": "Queue Download Job", "type": "main", "index": 0 }]] },
    "Queue Download Job": { "main": [[{ "node": "Wait 5s", "type": "main", "index": 0 }]] },
    "Wait 5s": { "main": [[{ "node": "Poll Job Status", "type": "main", "index": 0 }]] },
    "Poll Job Status": { "main": [[{ "node": "Queue Transcription", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "AI Content Factory" }]
}
